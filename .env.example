# Used by Docker Compose and as a reference for local development.
APP_ENV=development
AUTH_ENABLED=false

# Keycloak realm URL, for example: https://sso.example.com/realms/avelys
OIDC_ISSUER_URL=
OIDC_AUDIENCE=avelys-api

# Vue/OIDC client configuration. Use a public Keycloak client with PKCE.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=avelys-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_API_BASE_URL=/api

