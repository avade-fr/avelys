# Used by Docker Compose and as a reference for local development.
APP_ENV=development
AUTH_ENABLED=true

# Browser-facing issuer and Docker-internal JWKS endpoint for local Keycloak.
OIDC_ISSUER_URL=http://localhost:7000/realms/avelys
OIDC_JWKS_URL=http://keycloak:7000/realms/avelys/protocol/openid-connect/certs
OIDC_AUDIENCE=avelys-api
OIDC_SWAGGER_CLIENT_ID=avelys-web

# Vue/OIDC client configuration. Use a public Keycloak client with PKCE.
VITE_OIDC_AUTHORITY=http://localhost:7000/realms/avelys
VITE_OIDC_CLIENT_ID=avelys-web
VITE_API_BASE_URL=http://localhost:8000/v1
